{
  "name": "tisseo-live",
  "version": "1.5.0",
  "description": "Carte des véhicules du réseau Tisséo (Toulouse) en temps réel — positions estimées depuis le flux GTFS-RT TripUpdates + GTFS statique.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "prepare-gtfs": "node scripts/prepare-gtfs.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:e2e": "node test/e2e.mjs",
    "test:e2e:itineraire": "node test/e2e-itineraire.mjs",
    "test:e2e:metro": "node test/e2e-metro.mjs",
    "test:e2e:inventaire": "node test/e2e-inventaire.mjs",
    "test:e2e:iti": "node test/e2e-iti.mjs",
    "test:e2e:live": "node test/e2e-live.mjs",
    "test:e2e:hors-ligne": "node test/hors-ligne.mjs",
    "test:e2e:telephone": "node test/telephone.mjs",
    "test:e2e:navigateurs": "node test/navigateurs.mjs",
    "test:e2e:compte": "node test/e2e-compte.mjs",
    "test:e2e:compte-sw": "node test/e2e-compte-sw.mjs",
    "test:e2e:grande-ville": "node test/e2e-grande-ville.mjs",
    "test:e2e:trajet-complet": "node test/e2e-trajet-complet.mjs",
    "test:e2e:reseaux": "node test/e2e-reseaux.mjs",
    "verifier:traces": "node --test test/traces.test.mjs",
    "verifier:itineraires": "node --test test/itineraires.test.mjs",
    "verifier:performance": "node test/performance.mjs",
    "verifier:vitesse": "node test/vitesse.mjs",
    "verifier-mcp": "node scripts/verifier-mcp.mjs",
    "verifier:versions": "node scripts/versions.mjs",
    "supervised": "node updater/supervisor.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "adm-zip": "^0.5.16"
  },
  "engines": {
    "node": ">=20"
  }
}
