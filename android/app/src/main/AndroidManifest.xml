<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Rappels des trajets planifiés à l'heure. Refusée par défaut sur Android 14+ :
         l'utilisateur l'accorde dans « Alarmes et rappels », l'application le lui propose. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <application android:label="Ville &amp; Promenade" android:icon="@drawable/ic_city" android:theme="@style/AppTheme" android:allowBackup="false" android:networkSecurityConfig="@xml/network_security_config" android:supportsRtl="true">
        <!-- singleTask : le retour de la connexion Atlas (tisseo-ville://auth) doit
             revenir dans l'écran déjà ouvert, pas en ouvrir un second dans la tâche
             du navigateur. -->
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask" android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tisseo-ville" android:host="auth" />
            </intent-filter>
        </activity>
        <activity android:name=".WidgetConfigureActivity" android:exported="true"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter></activity>
        <receiver android:name=".DeparturesWidget" android:exported="false" android:label="Tisséo · prochains passages"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/departures_widget_info" /></receiver>
        <receiver android:name=".WidgetPinnedReceiver" android:exported="false" />
        <!-- Rappels des trajets planifiés : sonnerie (action interne) et repose des
             alarmes après un redémarrage du téléphone. -->
        <receiver android:name=".ReminderReceiver" android:exported="true"><intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter></receiver>
        <service android:name=".RefreshService" android:exported="true" android:permission="android.permission.BIND_JOB_SERVICE" />
        <service android:name=".WalkService" android:exported="false" android:foregroundServiceType="location" />
        <service android:name=".ShareService" android:exported="false" android:foregroundServiceType="location" />
    </application>
</manifest>
